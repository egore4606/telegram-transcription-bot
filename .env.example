# Required credentials
TELEGRAM_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_primary_gemini_api_key

# Optional backup credential
GEMINI_API_KEY_2=

# Gemini models and retry behavior
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_SUMMARY_MODEL=gemini-3.5-flash
MODEL_REQUEST_TIMEOUT=40
PRIMARY_MODEL_ATTEMPTS=1
FALLBACK_MODEL_ATTEMPTS=1

# Persistent storage and administrator
DATABASE_PATH=/data/bot.sqlite3
ADMIN_USER_ID=123456789

# Media and command limits
RATE_LIMIT=5
COMMAND_RATE_LIMIT=10
COMMAND_RATE_LIMIT_WINDOW_SECONDS=300
MAX_ACTIVE_JOBS_PER_USER=3
MAX_ACTIVE_JOBS_PER_CHAT=5
MAX_ACTIVE_JOBS_GLOBAL=5
MAX_QUEUED_JOBS=25
MAX_QUEUED_JOBS_PER_USER=5
MAX_MEDIA_BYTES=20971520
PENDING_FEEDBACK_TTL_SECONDS=900

# Progress-message refresh intervals in seconds
PROGRESS_PRIVATE_REFRESH_INTERVAL=1
PROGRESS_GROUP_REFRESH_INTERVAL=5

# Optional private side entrance for Personal Auto Transcriber (disabled by default).
# Use a separately generated random token of at least 32 characters, never a Telegram token.
INTEGRATION_API_ENABLED=0
INTEGRATION_API_TOKEN=
INTEGRATION_API_HOST=127.0.0.1
INTEGRATION_API_PORT=8082
INTEGRATION_DATABASE_PATH=/data/integration.sqlite3
INTEGRATION_PROCESSING_TIMEOUT=900
INTEGRATION_REQUESTS_PER_MINUTE=5
# Built GHCR images carry the source revision; local runs can set it explicitly.
# ENGINE_VERSION=your-build-revision
